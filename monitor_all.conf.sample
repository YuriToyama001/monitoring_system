# monitor_all.conf
# Common runtime configuration for monitor_all.sh and underlying scripts.

# Network interfaces to monitor
# Configure up to two interfaces with INTERFACE_1 and INTERFACE_2.
INTERFACE_1=eth0
INTERFACE_2=

# Per-interface gateway reachability check override
# Set ENABLE_GATEWAY_CHECK_1=false to disable the gateway check for INTERFACE_1.
ENABLE_GATEWAY_CHECK_1=true
ENABLE_GATEWAY_CHECK_2=false

# CPU usage warning threshold (%)
CPU_THRESHOLD=80

# CPU temperature warning threshold (°C)
CPU_TEMP_THRESHOLD=85

# Memory usage warning threshold (%)
MEMORY_THRESHOLD=90

# Network traffic warning threshold (%)
NETWORK_TRAFFIC_THRESHOLD=80

# Interval in seconds for scripts that need a sleep interval
NETWORK_TRAFFIC_INTERVAL=1

# External node to ping
NODE_HOST=172.16.1.151


# Redis connection settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Override the notifier used by monitor scripts.
# Default is notify/notify_redis.sh.
# Example: NOTIFY_SCRIPT=/path/to/custom_notifier.sh
NOTIFY_SCRIPT=

# Override the logger used by monitor scripts.
# Default is log_output/log_output.sh.
# Example: LOG_OUTPUT_SCRIPT=/path/to/custom_logger.sh
LOG_OUTPUT_SCRIPT=

# Log output directory for log_output.sh.
# Default is /var/log/monitor, but workspace-local path is used here for portability.
LOG_DIR=./log_output